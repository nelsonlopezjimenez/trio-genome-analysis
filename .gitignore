# Large data files
*.fa
*.fa.fai
*.vcf.gz
*.vcf.gz.tbi
*.vcf.gz.csi
*.gtf
*.gff3

# Results and temporary files
results/
trio_analysis/
*.log
temp/
data/derived/
*.db

# System files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Compressed files
*.tar.gz
*.zip
*.bz2

# But keep example/small files
!data/examples/*.fa
!data/examples/*.vcf


# Python bytecode cache
__pycache__/
*.pyc

# mine
*.gz

# Small chr22-only external-validation reference (see HANDOFF.md's external-validation finding) --
# ~1.1MB total, kept for external sanity-checking, unlike the genome-wide Ensembl downloads
# they're derived from (data/reference/validation/ensembl112_*.fa.gz, correctly excluded above).
# Must stay AFTER the *.gz rule above -- gitignore applies rules in order, and a negation before
# a later matching exclude gets overridden (this bit us once already, worth the comment).
!data/reference/validation/chr22_ensembl112.cds.fa.gz
!data/reference/validation/chr22_ensembl112.pep.fa.gz